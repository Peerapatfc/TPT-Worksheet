OPENAI_API_KEY=sk-...
# Free tier — used for brainstorm + content generation (text only). Get key: console.groq.com
GROQ_API_KEY=gsk_...
# Brainstorm LLM: openai (default, gpt-4o) | groq (openai/gpt-oss-120b, free tier).
# Compare npm run test:plan / npm run eval on both before switching CI.
BRAINSTORM_PROVIDER=
GOOGLE_DRIVE_FOLDER_ID=<from Drive URL /folders/{ID}>
# Flat folder linked to TPT — only combined PDF uploaded here (no PNGs/JSON/TXT)
GOOGLE_DRIVE_TPT_FOLDER_ID=<from Drive URL /folders/{ID}>
GOOGLE_OAUTH_CLIENT_ID=<OAuth2 client ID from Google Cloud Console>
GOOGLE_OAUTH_CLIENT_SECRET=<OAuth2 client secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<run: node scripts/get-refresh-token.js>
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_CHANNEL_ID=-1001234567890
# Optional: where the post-run review summary goes (defaults to TELEGRAM_CHANNEL_ID).
# Set this to a private chat if the channel is public.
TELEGRAM_REVIEW_CHAT_ID=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# GRADE_LEVEL options:
#   specific: "Grade 3"
#   range:    "Grade 1-5"  (AI picks best within range)
#   omit:     AI picks any grade Kindergarten-Grade 6
GRADE_LEVEL=
# Package tiers — structure: 1 cover + N worksheets + ceil(N/2) answer_keys
#   free:  total  7–10 pages,        price $0     (FREE_WORKSHEET_DAY)
#   small: total 15–20 pages,        price $2–5   (all other days)
#   large: total 21–MAX_PAGES pages, price $5–15  (LARGE_PACKAGE_DAY)
MAX_PAGES_PER_SET=40
# Day of week to publish a free worksheet (0=Sun, 1=Mon, ..., 6=Sat). Default: 0 (Sunday)
FREE_WORKSHEET_DAY=0
# Day of week to publish a large package. Omit to never run large.
LARGE_PACKAGE_DAY=
# Pages generated concurrently (image-gen + QA). Default 1 (sequential).
# Raise to 2–3 to cut wall-clock time; higher values risk OpenAI image rate limits.
PAGE_CONCURRENCY=1
# Cover renderer. "hybrid" = Cloudflare FLUX (free) draws the cover illustration and code
# draws the title/text; needs both CLOUDFLARE_* values. Empty = gpt-image-2 cover (default).
# Any hybrid failure falls back to gpt-image-2 automatically.
COVER_RENDERER=
# Worksheet/activity page renderer. "hybrid" = pages whose content fits a code layout
# (plain questions, fill-in-the-blank) are drawn by code with one FLUX spot illustration
# (needs the CLOUDFLARE_* values; a FLUX failure draws decorative motifs instead); other
# pages stay on gpt-image-2. Empty/openai = gpt-image-2 for every page (default).
PAGE_RENDERER=
# Concurrent FLUX calls for hybrid pages. Default 2.
ILLUSTRATION_CONCURRENCY=2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Q&A recheck calls (Groq) run in parallel. Default 1: the free tier is 8000 tokens/minute
# and one call is ~7k, so two at once always 429. Raise only on a paid Groq tier.
RECHECK_CONCURRENCY=1
